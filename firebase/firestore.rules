rules_version = '2';

// Mashtal Firestore security rules (TF-04, NFR-05).
// Roles are enforced here, on the server, not only in the app UI.
// Data model: docs/data-model.md
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function managesPartner(id) { return (hasRole('nursery') || hasRole('professional')) && me().partnerId == id; }
    function nurseryVerified(id) {
      return get(/databases/$(database)/documents/nurseries/$(id)).data.status == 'verified';
    }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // TF-03: the app signs in to an Email/Password account named after the
    // phone number, e.g. 966500000001@phone.mashtal.app, after showing the
    // code on screen. This is the signed-in number in +966 form.
    function myPhone() {
      return signedIn() && request.auth.token.email is string
        ? '+' + request.auth.token.email.split('@')[0] : null;
    }
    function partnerAccount(phone) { return get(/databases/$(database)/documents/partnerAccounts/$(phone)).data; }
    function hasPartnerAccount(phone) { return exists(/databases/$(database)/documents/partnerAccounts/$(phone)); }
    // A role is either plain customer, or exactly what the admin gave this number.
    function roleAllowed(d) {
      return hasPartnerAccount(d.phone)
        ? d.role == partnerAccount(d.phone).role && d.get('partnerId', null) == partnerAccount(d.phone).get('partnerId', null)
        : d.role == 'customer' && d.get('partnerId', null) == null;
    }

    // US-02: a user creates their own profile after signing in. Partner and
    // admin roles come only from partnerAccounts, which the admin writes.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'name', 'city', 'role', 'partnerId', 'createdAt'])
        && request.resource.data.phone == myPhone()
        && roleAllowed(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update: if (signedIn() && request.auth.uid == uid && onlyChanges(['name', 'city']))
        || (signedIn() && request.auth.uid == uid && onlyChanges(['role', 'partnerId']) && roleAllowed(request.resource.data))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Which numbers sign in as a nursery, a professional or the admin. The
    // first admin number is added by hand in the Firebase console.
    match /partnerAccounts/{phone} {
      allow read: if myPhone() == phone || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.role in ['nursery', 'professional', 'admin'];
      allow delete: if isAdmin();
    }

    // Marks that the admin uploaded the demo data.
    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Plant knowledge base: public, edited by the admin (US-14). A nursery may
    // add a plant missing from the list; it is marked as not guide-backed and
    // only that nursery or the admin can delete it.
    match /plants/{plantId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if hasRole('nursery')
        && request.resource.data.guideBacked == false
        && request.resource.data.addedBy == me().partnerId
        && (request.resource.data.nameAr is string || request.resource.data.nameEn is string);
      allow delete: if hasRole('nursery') && resource.data.get('addedBy', null) == me().partnerId;
    }

    // US-03: only verified partners are visible to customers and guests.
    match /nurseries/{id} {
      allow read: if resource.data.status == 'verified' || isAdmin() || managesPartner(id);
      allow create: if isAdmin() && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /professionals/{id} {
      allow read: if resource.data.status == 'verified' || isAdmin() || managesPartner(id);
      allow create: if isAdmin() && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
      // A professional chooses the services they offer and the cities they cover.
      allow update: if hasRole('professional') && managesPartner(id) && onlyChanges(['services', 'cities'])
        && request.resource.data.services.size() > 0 && request.resource.data.cities.size() > 0;
    }

    // US-06: a nursery manages its own listings. `public` is true only when the
    // listing is not hidden and its nursery is verified, so customer queries can
    // filter on it; the admin updates it when a nursery's status changes.
    match /listings/{id} {
      function validListing(d) {
        return d.keys().hasOnly(['nurseryId', 'plantId', 'price', 'quantity', 'hidden', 'public', 'photo', 'updatedAt'])
          && d.price is number && d.price > 0 && d.price <= 100000
          && d.quantity is int && d.quantity >= 0
          && d.hidden is bool
          && exists(/databases/$(database)/documents/plants/$(d.plantId))
          && d.public == (!d.hidden && nurseryVerified(d.nurseryId));
      }

      allow read: if resource.data.public == true || isAdmin() || managesPartner(resource.data.nurseryId);
      allow create: if hasRole('nursery') && managesPartner(request.resource.data.nurseryId)
        && validListing(request.resource.data);
      allow update: if hasRole('nursery') && managesPartner(resource.data.nurseryId)
        && request.resource.data.nurseryId == resource.data.nurseryId
        && request.resource.data.plantId == resource.data.plantId
        && validListing(request.resource.data);
      allow update: if isAdmin() && onlyChanges(['public']);
      allow delete: if hasRole('nursery') && managesPartner(resource.data.nurseryId);
      // The admin uploads the demo listings and removes a deleted nursery's.
      allow create: if isAdmin() && validListing(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin-set service price ranges (US-13).
    match /priceRanges/{serviceId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.min is number && request.resource.data.max is number
        && request.resource.data.min < request.resource.data.max;
    }

    // US-16: a signed-in customer reserves; one document per nursery. The
    // customer and that nursery can read it.
    match /reservations/{id} {
      function validItem(i) {
        return i.keys().hasOnly(['listingId', 'plantId', 'price', 'quantity'])
          && i.quantity is int && i.quantity > 0 && i.price is number && i.price > 0;
      }
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid
        || managesPartner(resource.data.nurseryId) || isAdmin());
      allow create: if hasRole('customer')
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'customerPhone', 'nurseryId', 'items', 'createdAt', 'status'])
        && request.resource.data.customerId == request.auth.uid
        && '+966' + request.resource.data.customerPhone.split('^0')[1] == myPhone()
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20
        && validItem(request.resource.data.items[0]);

      // US-17: the nursery accepts (the 48-hour hold starts at acceptedAt) or
      // rejects with a reason, only while the reservation is pending.
      allow update: if hasRole('nursery') && managesPartner(resource.data.nurseryId)
        && resource.data.status == 'pending'
        && ((request.resource.data.status == 'accepted' && request.resource.data.acceptedAt is string
              && onlyChanges(['status', 'acceptedAt']))
          || (request.resource.data.status == 'rejected' && request.resource.data.rejectReason in ['outOfStock', 'other']
              && onlyChanges(['status', 'rejectReason'])));
    }

    // US-21: My Garden. Each customer reads and changes only their own plants.
    match /garden/{id} {
      function validGarden(d) {
        return d.keys().hasOnly(['ownerId', 'plantId', 'addedAt', 'source', 'quantity', 'reservationId', 'nurseryId', 'lastWateredAt'])
          && d.ownerId == request.auth.uid
          && d.addedAt is string
          && d.quantity is int && d.quantity > 0 && d.quantity <= 1000
          && exists(/databases/$(database)/documents/plants/$(d.plantId));
      }
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if hasRole('customer') && validGarden(request.resource.data)
        && request.resource.data.source == 'manual';
      allow update: if hasRole('customer') && resource.data.ownerId == request.auth.uid
        && onlyChanges(['lastWateredAt']) && request.resource.data.lastWateredAt is string;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // US-14: every admin edit to plant data is logged and the log cannot be
    // changed afterwards.
    match /plantEdits/{editId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.editorId == request.auth.uid
        && request.resource.data.plantId is string
        && request.resource.data.field in ['placements', 'sun', 'water', 'wateringEveryDays', 'toxic'];
      allow update, delete: if false;
    }
  }
}
